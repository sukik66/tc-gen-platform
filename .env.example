# =============================================================================
# 大模型提供方 LLM_PROVIDER（必填其一对应的密钥）
# 可选值：
#   gemini   — Google Gemini（走 Google SDK，非 OpenAI 兼容）
#   openai   — OpenAI 官方或任意 OpenAI 兼容网关
#   qwen     — 阿里通义 DashScope 兼容模式
#   ernie    — 百度文心千帆 OpenAI 兼容
#   doubao   — 字节豆包（火山引擎方舟）
#   glm      — 智谱 GLM
#   minimax  — MiniMax
#   kimi     — 月之暗面 Moonshot
#   deepseek — DeepSeek
#   anthropic— Anthropic Claude（官方 OpenAI SDK 兼容层，侧栏单独一项）
# =============================================================================
LLM_PROVIDER=openai

# -----------------------------------------------------------------------------
# Anthropic Claude（LLM_PROVIDER=anthropic；与 OpenAI 通道分离，便于侧栏选择）
# 文档：https://platform.claude.com/docs/en/api/openai-sdk
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-sonnet-4-6
# 中转命名可能与官网展示不一致：例如 jbt.model123.dev 可用「claude-sonnet-4-6」，而「claude-sonnet-4.6」会 503。以控制台 / GET /v1/models（若未 403）为准；也可用 npm run probe:anthropic-models

# -----------------------------------------------------------------------------
# OpenAI（或自建兼容网关，OneAPI 等也可把网关地址填在 OPENAI_BASE_URL）
# 须以 /v1 结尾。若只填根域名（无路径），服务端会对 openai 等通道自动补 /v1。
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 官方 Chat Completions 模型 id 示例：gpt-5.4（以 OpenAI 文档为准）；中转须支持同名模型
OPENAI_MODEL=gpt-5.4

# -----------------------------------------------------------------------------
# Google Gemini（LLM_PROVIDER=gemini）
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=
# 或 GOOGLE_AI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# 阿里通义 Qwen（LLM_PROVIDER=qwen，DashScope OpenAI 兼容）
# 文档：https://help.aliyun.com/zh/dashscope/developer-reference/compatibility-of-openai-with-dashscope
# -----------------------------------------------------------------------------
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-turbo

# -----------------------------------------------------------------------------
# 百度文心 ERNIE（LLM_PROVIDER=ernie，千帆 OpenAI 兼容）
# 认证方式以千帆控制台为准；若需 AK/SK 换 token，请按官方文档或使用兼容中转。
# -----------------------------------------------------------------------------
# ERNIE_API_KEY=
# ERNIE_BASE_URL=https://qianfan.baidubce.com/v2
# ERNIE_MODEL=ernie-4.0-8k

# -----------------------------------------------------------------------------
# 字节豆包（LLM_PROVIDER=doubao，火山方舟 Ark，OpenAI 兼容）
# DOUBAO_MODEL 一般为推理接入点 ID（如 ep-xxxx），须在方舟控制台创建。
# -----------------------------------------------------------------------------
# DOUBAO_API_KEY=
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_MODEL=

# -----------------------------------------------------------------------------
# 智谱 GLM（LLM_PROVIDER=glm）
# -----------------------------------------------------------------------------
# GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4-flash

# -----------------------------------------------------------------------------
# MiniMax（LLM_PROVIDER=minimax）
# -----------------------------------------------------------------------------
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=abab6.5s-chat

# -----------------------------------------------------------------------------
# 月之暗面 Kimi / Moonshot（LLM_PROVIDER=kimi）
# 模型 id 以官方 OpenAPI / List Models 为准（国际文档多为 https://api.moonshot.ai/v1 ，国内常用 https://api.moonshot.cn/v1 ，以控制台为准）。
# kimi-k2.6 / kimi-k2.5 等为 K2 系列；moonshot-v1-8k 总上下文仅 8192（含输入+输出）。kimi 通道为 shared_context_window，服务端会压缩 max_tokens 并在超窗时提示。
# -----------------------------------------------------------------------------
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=kimi-k2.6

# -----------------------------------------------------------------------------
# DeepSeek（LLM_PROVIDER=deepseek）
# -----------------------------------------------------------------------------
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# deepseek-reasoner：V3.2 推理档（Thinking）；通用对话档为 deepseek-chat。以 https://api-docs.deepseek.com/quick_start/pricing 为准。
# DEEPSEEK_MODEL=deepseek-v4-pro
# 同 provider 多 model：填了之后前端会出现「具体模型」下拉，逗号 / 空格分隔；首项默认与 DEEPSEEK_MODEL 相同
# 兼容 deepseek-v4-pro（带 reasoning_content 推理过程）/ deepseek-v4-flash 等
# DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash,deepseek-reasoner,deepseek-chat

# 同 provider 多 model 通用规则：
# - 任何 OpenAI 兼容通道都支持 ${PROVIDER}_MODELS（CSV 或空格分隔），例：
#   OPENAI_MODELS=gpt-5.4,gpt-5.4-mini
#   ANTHROPIC_MODELS=claude-sonnet-4-6,claude-opus-4-1
#   KIMI_MODELS=kimi-k2.6,moonshot-v1-32k
# - 留空 / 只配置一个时，前端只显示通道，不显示「具体模型」下拉
# - 列表中必须包含 ${PROVIDER}_MODEL（默认模型），否则系统会自动把它放在第一位
# - 前端选择的 model 必须在白名单内才会被后端采用，防止注入未授权模型 id

# -----------------------------------------------------------------------------
# 调试（可选）
# -----------------------------------------------------------------------------
# 设为 1 / true / yes 时，API 进程在控制台打印 OpenAI 兼容请求的 model、max_tokens、baseURL（仅 origin+路径）、
# 是否使用 json_object、是否降级重试、流式 finish_reason、输出字符数（不打印 API Key）。
# DEBUG_LLM=1
#
# 不看终端也可排障：至少成功发起过一次生成后，浏览器打开 GET /api/llm-last-meta（开发时经 Vite 代理为同路径，如 http://localhost:5173/api/llm-last-meta）

# -----------------------------------------------------------------------------
# 服务与限流
# -----------------------------------------------------------------------------
API_PORT=8787
# 可选：项目内或绝对路径的测试用例设计方法论文件
# METHODOLOGY_FILE=knowledge/参考/测试用例设计方法论.md
# 可选：Plastic SCM cm.exe 路径
# PLASTIC_CM_PATH=C:\\Program Files\\PlasticSCM5\\client\\cm.exe
# 可选：开发调试上报地址，默认关闭；独立迁移时保持为空
# DEBUG_INGEST_URL=
# VITE_DEBUG_INGEST_URL=
# 若 8787 与其它程序冲突，可改为例如 8788，并确保 vite 能读到同一 .env（已自动代理到该端口）
LLM_MAX_DOC_CHARS=120000
# 可选：契约提取 LLM 单次 SDK 超时（毫秒），QA 档 JSON 较长，默认 900000（15 分钟）
# LLM_CONTRACTS_TIMEOUT_MS=900000
# 可选：用例/增强流式等 OpenAI 兼容通道 SDK 超时（毫秒），默认 900000
# LLM_OPENAI_COMPAT_TIMEOUT_MS=900000
# 可选：前端 fetch 契约提取超时（毫秒），默认 960000（16 分钟），需略大于上一项
# VITE_GENERATE_CONTRACTS_TIMEOUT_MS=960000
# 可选：本地 API 监听地址（默认 127.0.0.1，一般无需改）
# VITE_DEV_API_HOST=127.0.0.1

# --- Pipeline 超时参数（毫秒，可选，有默认值）---
# 设计哲学：参考 QA 智能测试平台 TOOL_TIMEOUT=300s 的"慢但稳"策略；
# 不设整体硬超时，每步独立超时 + 失败返 stub，宁可等也不要全报错。
# PIPELINE_SINGLE_CALL_TIMEOUT_MS=240000   # 单次 LLM 调用超时（默认 240s = 4 分钟）
# PIPELINE_STEP2_SKIP_AFTER_MS=300000      # 代码预分析超过该时长则跳过需求分析，直接进最终生成（默认 300s = 5 分钟）
# STREAM_FIRST_TOKEN_TIMEOUT_MS=180000     # 最终生成等待首 token 超时（默认 180s = 3 分钟，DeepSeek 大 prompt 下 30-60s 出首 token 是常态）
# STREAM_CLIENT_TIMEOUT_MS=600000          # OpenAI 客户端整体超时（默认 600s = 10 分钟，留足流式生成时间）

# 生产环境前端若与 API 不同域，构建前设置（留空则使用相对路径 /api）
# VITE_API_BASE_URL=

# 修订记录自动上报：末次编辑用例后空闲多少毫秒再 POST（默认 120000=2 分钟，最低 5000）。
# 断续改标题/描述时不会被过早截断；点击「API 生成」前仍会强制上报一轮。
# VITE_REVISION_LOG_IDLE_MS=120000
